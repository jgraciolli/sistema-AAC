<?xml version="1.0" encoding="UTF-8"?>

<!-- Figma: "Listagem de pranchas" (node 1:2) -->

<?import UI.componentes.FraseBarra?>
<?import UI.componentes.GradeResponsiva?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="UI.controllers.PranchasController"
      styleClass="tela, tela-pranchas">

    <HBox styleClass="cabecalho-pranchas">
        <Label text="Calopsito" styleClass="titulo-app"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Adicionar prancha" styleClass="botao-primario" onAction="#adicionarPrancha"/>
    </HBox>

    <!-- TODO: busca de prancha por número/nome (versão 0.3.0) -->
    <TextField promptText="Digite o nome ou número da prancha" styleClass="campo-busca"/>

    <Label fx:id="mensagemVazia" text="Nenhuma prancha inserida. Clique em &quot;Adicionar prancha&quot; para começar."
           styleClass="mensagem-vazia"/>

    <ScrollPane fitToWidth="true" styleClass="rolagem" VBox.vgrow="ALWAYS">
        <GradeResponsiva fx:id="gradePranchas" larguraMinima="190"/>
    </ScrollPane>

    <FraseBarra/>
</VBox>
